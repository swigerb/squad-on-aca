# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union
.squad/rai/audit-trail.md merge=union
.squad/fact-checker/audit-trail.md merge=union

# Worker tests run under bash; keep shell/test inputs LF-normalized on Windows.
worker/**/*.sh text eol=lf
worker/tests/fixtures/*.yml text eol=lf
worker/tests/expected/*.json text eol=lf
config/*.json text eol=lf
.github/workflows/*.yml text eol=lf

# squad-aca CLI golden captures are compared byte-for-byte by
# scripts/tests/verify-cli-golden.ps1; keep them LF on every checkout.
scripts/tests/golden/cli/*.txt text eol=lf

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline by construction. These tests never touch Azure, never start
    PowerShell and never open a socket: the only seam to the outside world is
    ISquadCliInvoker, and every test here supplies a fake. That is what makes
    them runnable in CI on a machine with no cloud credentials.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Squad.Aca.Agents.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Squad.Aca.Agents\Squad.Aca.Agents.csproj" />
  </ItemGroup>

</Project>
